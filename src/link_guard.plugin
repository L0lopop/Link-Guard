def _grab(module_name, attribute):
    try:
        module = __import__(module_name, fromlist=[attribute])
        return getattr(module, attribute, None)
    except Exception:
        return None


send_document = _grab("client_utils", "send_document")
get_user_config = _grab("client_utils", "get_user_config")
